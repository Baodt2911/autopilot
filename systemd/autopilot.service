[Unit]
Description=Autopilot: quét PR và điều phối worker (một lượt)

[Service]
Type=oneshot
# Workers are detached `claude -p` children: keep them alive when the scan ends.
KillMode=process
ExecStart=%h/.claude/scripts/autopilot/.venv/bin/autopilot scan --all
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
